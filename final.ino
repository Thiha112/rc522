// ============================
// RELAY CONTROL
// ============================
void floorON(int pin) {
  digitalWrite(pin, FLOOR_ACTIVE_LOW ? LOW : HIGH);
}

void floorOFF(int pin) {
  digitalWrite(pin, FLOOR_ACTIVE_LOW ? HIGH : LOW);
}

void groundON() {
  digitalWrite(groundRelay, GROUND_ACTIVE_HIGH ? HIGH : LOW);
}

void groundOFF() {
  digitalWrite(groundRelay, GROUND_ACTIVE_HIGH ? LOW : HIGH);
}

// ============================
// SAFE STATE
// ============================
void safeState() {

  for (int i = 0; i < 12; i++) {
    floorOFF(floorRelay[i]);
  }

  groundOFF();

  accessActive = false;
  serviceMode = false;
  activeFloor = -1;

  Serial.println("SAFE STATE");
}

// ============================
// BUZZER
// ============================
void beep(int t) {
  digitalWrite(BUZZER_PIN, HIGH);
  delay(t);
  digitalWrite(BUZZER_PIN, LOW);
}

void beepSuccess() { beep(100); }
void beepService() { beep(100); delay(100); beep(100); }
void beepError() { beep(500); }

// ============================
// UID MATCH
// ============================
bool matchUID(byte *a, byte *b) {
  for (byte i = 0; i < 4; i++) {
    if (a[i] != b[i]) return false;
  }
  return true;
}

// ============================
// FLOOR FIND
// ============================
int getFloor(byte *uid) {
  for (int f = 0; f < 12; f++) {
    for (int c = 0; c < 6; c++) {
      if (matchUID(uid, floorCards[f][c])) return f;
    }
  }
  return -1;
}

// ============================
// SERVICE CHECK
// ============================
bool isService(byte *uid) {
  for (int i = 0; i < 4; i++) {
    if (matchUID(uid, serviceCards[i])) return true;
  }
  return false;
}

// ============================
// SETUP
// ============================
void setup() {

  Serial.begin(9600);

  pinMode(BUZZER_PIN, OUTPUT);

  for (int i = 0; i < 12; i++) {
    pinMode(floorRelay[i], OUTPUT);
  }

  pinMode(groundRelay, OUTPUT);

  safeState();

  // WATCHDOG
  wdt_enable(WDTO_2S);

  // RC522 POWER STABILITY DELAY
  delay(1000);
  SPI.begin();
  delay(200);

  mfrc522.PCD_Init();
  delay(100);

  Serial.println("SYSTEM READY");
}

// ============================
// LOOP
// ============================
void loop() {

  wdt_reset();

  // periodic RFID recovery
  static unsigned long rfidFix = 0;
  if (millis() - rfidFix > 10000) {
    mfrc522.PCD_Init();
    rfidFix = millis();
  }

  if (!mfrc522.PICC_IsNewCardPresent()) return;
  if (!mfrc522.PICC_ReadCardSerial()) return;

  byte *uid = mfrc522.uid.uidByte;

  int floor = getFloor(uid);

  if (isService(uid)) {

    beepService();
    groundON();

    for (int i = 0; i < 12; i++) {
      floorON(floorRelay[i]);
    }

    serviceMode = true;
    accessActive = true;
  }

  else if (floor != -1) {

    beepSuccess();

    groundON();
    floorON(floorRelay[floor]);

    activeFloor = floor;
    accessActive = true;
  }

  else {

    beepError();
    safeState();
    return;
  }

  accessStart = millis();

  mfrc522.PICC_HaltA();
  mfrc522.PCD_StopCrypto1();
}
