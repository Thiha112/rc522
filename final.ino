const bool GROUND_ACTIVE_HIGH = true;

// ============================
// STATE
// ============================
const unsigned long ACCESS_TIME = 5000;
unsigned long accessStart = 0;
bool accessActive = false;

int activeFloor = -1;
bool serviceMode = false;

